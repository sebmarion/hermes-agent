# Daily upstream merge timer (runs at 04:30 Europe/Paris)
# One oneshot trigger per day; the service does the rest.

[Unit]
Description=Daily Hermes upstream merge timer

[Timer]
OnCalendar=*-*-* 04:30:00 Europe/Paris
Persistent=true
Unit=hermes-upstream-merge.service

[Install]
WantedBy=timers.target
