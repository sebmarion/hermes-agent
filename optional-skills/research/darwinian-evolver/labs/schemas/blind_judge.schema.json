{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blind Judge Row",
  "description": "One row of the blind A/B judge JSONL produced by a non-Zeus reviewer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "blind_candidate",
    "judge_model",
    "score",
    "verdict",
    "reasoning"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": {
      "type": "string",
      "pattern": "^task_[0-9a-f]{4,}$"
    },
    "blind_candidate": {
      "enum": ["A", "B"],
      "description": "Which blind arm this judge row refers to."
    },
    "judge_model": {
      "type": "string",
      "minLength": 5
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verdict": {
      "enum": ["better", "equal", "worse"],
      "description": "Only these three outcomes are allowed. 'equal' is a legitimate result."
    },
    "reasoning": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    }
  }
}
